{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "name": "Neuro 设计方案",
  "description": "Neuro 产品统一的深色工业终端设计基线。",
  "colors": {
    "primary": {
      "signalYellow": "#d9ff38",
      "signalGreen": "#22c55e"
    },
    "semantic": {
      "infoBlue": "#06b6d4",
      "dangerRed": "#f43f5e"
    },
    "neutral": {
      "background": "#06080d",
      "surface": "#090c11",
      "panel": "#0e1218",
      "rail": "#070a0f",
      "control": "#111720",
      "controlHover": "#18222c",
      "text": "#f7f8ef",
      "textMuted": "#929a9f",
      "line": "rgba(255, 255, 255, 0.12)",
      "focusSurface": "#f3f5f1",
      "focusInk": "#20252b",
      "focusMuted": "#656b72"
    }
  },
  "derivedStates": {
    "yellowHover": "color-mix(in srgb, #d9ff38 86%, white)",
    "yellowPressed": "color-mix(in srgb, #d9ff38 82%, black)",
    "yellowSoft": "color-mix(in srgb, #d9ff38 14%, #0e1218)",
    "greenHover": "color-mix(in srgb, #22c55e 86%, white)",
    "greenPressed": "color-mix(in srgb, #22c55e 82%, black)",
    "greenSoft": "color-mix(in srgb, #22c55e 14%, #0e1218)",
    "infoSoft": "color-mix(in srgb, #06b6d4 12%, #0e1218)",
    "dangerSoft": "color-mix(in srgb, #f43f5e 12%, #0e1218)"
  },
  "roles": {
    "signalYellow": [
      "当前激活",
      "键盘焦点",
      "唯一主操作",
      "需要用户注意的非错误状态"
    ],
    "signalGreen": [
      "Neuro/Loom 品牌标识",
      "在线",
      "成功",
      "完成",
      "正向次级状态"
    ],
    "infoBlue": [
      "链接",
      "同步",
      "设备",
      "低风险信息状态"
    ],
    "dangerRed": [
      "错误",
      "删除",
      "高风险权限",
      "破坏性操作"
    ]
  },
  "composition": {
    "shell": "深色近不透明 slab",
    "focusSurface": "白底灰黑字，只用于选中项、重点阅读面或短时焦点",
    "motifs": [
      "切角信号三角",
      "克制的斜线",
      "低对比同心圆",
      "细分隔线与局部网格"
    ],
    "radius": "中小圆角；避免气泡化和满屏 pill",
    "density": "高信息密度，长内容使用明确的内部滚动边界"
  }
}
