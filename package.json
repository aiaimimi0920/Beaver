{
  "name": "beaver-studio",
  "version": "0.1.19",
  "beaverBuild": 36,
  "private": true,
  "description": "Local conversation-driven Godot game studio",
  "main": "dist/main.cjs",
  "scripts": {
    "check:effective-lines": "cargo run --quiet --locked -p beaver-core --bin beaver-code-structure -- --root . --repo --baseline scripts/effective-code-lines-baseline.json --json output/effective-code-lines.json",
    "check:effective-lines:strict": "cargo run --quiet --locked -p beaver-core --bin beaver-code-structure -- --root . --repo --strict --json output/effective-code-lines-strict.json",
    "test:effective-lines": "cargo test --locked -p beaver-core code_structure",
    "build:native:ui": "tsx scripts/build-native.ts",
    "preview:objects": "tsx scripts/preview-object-ui.ts",
    "build:native": "npm run check:effective-lines && npm run build:native:ui && cargo build --release --locked -p beaver-desktop && tsx scripts/stamp-native-version.ts",
    "check:native": "cargo check --locked -p beaver-desktop",
    "package:native": "npm run build:native && tsx scripts/package-native.ts",
    "verify:native-release": "tsx scripts/verify-native-release.ts",
    "verify:native-store": "tsx scripts/native-store-smoke.ts",
    "verify:native-backup": "tsx scripts/native-backup-smoke.ts",
    "verify:native-migration": "tsx scripts/native-migration-smoke.ts",
    "verify:native-import": "tsx scripts/native-import-smoke.ts",
    "verify:native-session-migration": "cargo build --locked -p beaver-core --example migrated_session && tsx scripts/native-session-migration-smoke.ts",
    "verify:native-business": "tsx scripts/native-business-smoke.ts",
    "verify:native-brief": "tsx scripts/native-brief-smoke.ts",
    "verify:native-media": "npm run build:native:ui && cargo build --locked -p beaver-desktop && tsx scripts/native-media-smoke.ts",
    "build:icons": "tsx scripts/build-icons.ts",
    "build": "npm run build:icons && tsx scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:native:fresh": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-fresh-native-test.ps1",
    "verify:codex": "tsx scripts/codex-smoke.ts",
    "verify:godot": "tsx scripts/godot-smoke.ts",
    "verify:features": "tsx scripts/features-smoke.ts",
    "verify:desktop": "node scripts/desktop-smoke.mjs",
    "check": "npm run check:effective-lines && npm run typecheck && npm test && npm run build",
    "format": "prettier --write src tests scripts package.json tsconfig.json",
    "format:check": "prettier --check src tests scripts package.json tsconfig.json",
    "package": "npm run build && tsx scripts/package.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "smol-toml": "1.8.0",
    "three": "^0.180.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "electron": "44.2.0",
    "esbuild": "^0.25.12",
    "pe-library": "2.0.1",
    "prettier": "^3.6.2",
    "resedit": "3.1.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
